# The development and preview scripts explicitly enable test accounts and bind to 127.0.0.1.
# Optional PowerShell overrides (environment files are not loaded automatically):
# $env:PORT = "5178"
# $env:SIESIE_DB_PATH = "data/siesie.sqlite"
# $env:SIESIE_TEST_MODE = "0"   # disables all demo sign-in / registration endpoints

# Live Supabase build: copy to .env.local and fill in PUBLIC connection values.
# Use npm run dev:live / npm run build:live. Vercel needs the same build variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put a service-role key, database password or Paystack secret in VITE_ variables.
